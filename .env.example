# ─── Z.AI (primary LLM provider) ──────────────────────────────────────────
# Get your key at the GOSIM hackathon check-in desk.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6
ZAI_VISION_MODEL=glm-4v

# ─── OpenAI fallback (dev only — used until ZAI key is in hand) ───────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── ElevenLabs (optional — premium TTS for final demo video) ─────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Tavily (optional — live web scam intel for analyze_email) ────────────
# Without this key, search_scam_intel falls back to fixture data — fine for demo.
TAVILY_API_KEY=

# ─── External scam-intel APIs (all optional, all free-tier) ───────────────
# Keys missing → check_url uses mock fixtures + no-JS fetch only (demo-safe).
# Get keys at:
#   https://developers.google.com/safe-browsing  (free, non-commercial)
#   https://urlscan.io/user/signup/              (free read access without key,
#                                                 key lifts rate limit)
#   https://emailrep.io/                         (free tier, ~50 req/day
#                                                 unauthenticated)
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_API_KEY=
EMAILREP_API_KEY=

# ─── Backend ──────────────────────────────────────────────────────────────
BACKEND_PORT=8787
WIKI_DIR=./data/wiki
RAW_DIR=./data/raw

# ─── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws
