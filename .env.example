# ─── LLM provider (proxied via api.r9s.ai/v1 for GOSIM) ───────────────────
# The GOSIM hackathon credentials route through https://api.r9s.ai/v1, an
# OpenAI-compatible proxy that exposes:
#   - deepseek-v4-pro     (DEFAULT — clean output, native tool-calling, json_mode)
#   - deepseek-v4-flash   (faster, cheaper, slightly less capable)
#   - glm-5  /  glm-5.1   (Z.AI flagship; runs in Thinking Mode by default
#                          on this proxy, which leaks chain-of-thought into
#                          message.content. Suppression flags are stripped
#                          by the proxy. We default to DeepSeek for demo
#                          reliability and switch to GLM only on a direct
#                          Z.AI key — see ADR in CLAUDE.md.)
#
# The proxy does NOT expose vision (GLM-4V/5V) or audio (GLM-ASR-2512).
# For full Z.AI access (vision + audio + GLM-Image + CogVideoX), ask the
# Z.AI mentor on-site for a direct https://api.z.ai/api/paas/v4 key.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.r9s.ai/v1
ZAI_MODEL=glm-5.1
ZAI_VISION_MODEL=
ZAI_FALLBACK_MODEL=deepseek-v4-flash

# ─── OpenAI fallback (dev only — used until ZAI key is in hand) ───────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── OpenAI Realtime (continuous voice loop, browser ↔ gpt-realtime) ──────
# When OPENAI_API_KEY is set, the browser switches from the click-mic
# Whisper round-trip to a low-latency WebRTC peer connection straight
# to OpenAI's gpt-realtime model. Tools are dispatched on the backend
# via /voice/tool. Without OPENAI_API_KEY the click-mic flow is the
# default (no degradation). Voices: marin (warm female, default), sage,
# shimmer, coral, ash, ballad, alloy, echo, verse.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# ─── ElevenLabs (optional — premium TTS for final demo video) ─────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Tavily (optional — live web scam intel for analyze_email) ────────────
# Without this key, search_scam_intel falls back to fixture data — fine for demo.
TAVILY_API_KEY=

# ─── External scam-intel APIs (all optional, all free-tier) ───────────────
# Keys missing → check_url uses mock fixtures + no-JS fetch only (demo-safe).
# Get keys at:
#   https://developers.google.com/safe-browsing  (free, non-commercial)
#   https://urlscan.io/user/signup/              (free read access without key,
#                                                 key lifts rate limit)
#   https://emailrep.io/                         (free tier, ~50 req/day
#                                                 unauthenticated)
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_API_KEY=
EMAILREP_API_KEY=

# ─── Wake-word (optional — falls back to push-to-talk if missing) ─────────
# Get your free key at https://console.picovoice.ai
# Without a key, the wake-word path is silently disabled and ctrl+option
# (push-to-talk) is the only way to activate Xiexie.
# Optional: train a custom "Xiexie" .ppn model in the Picovoice console and
# drop it at ./models/xiexie_mac.ppn (or set XIEXIE_PPN_PATH). Without a
# custom model we fall back to the built-in "computer" keyword for demos.
PICOVOICE_ACCESS_KEY=
XIEXIE_PPN_PATH=

# ─── Email source for read_emails / analyze_email / archive_email ────────
# "mailapp" = read the user's real macOS Mail.app inbox via AppleScript
# "demo"    = read data/demo/inbox.json (deterministic fixture)
# Requires Apple Events permission for the process running uvicorn:
#   System Settings → Privacy & Security → Automation → <Terminal/Cursor>
#   → check "Mail" the first time the backend asks.
MAIL_SOURCE=mailapp

# ─── Backend ──────────────────────────────────────────────────────────────
BACKEND_PORT=8787
# WIKI_DIR / RAW_DIR — leave commented to use the repo-root defaults
# (config.py resolves to <repo>/data/wiki and <repo>/data/raw automatically)
# WIKI_DIR=
# RAW_DIR=

# ─── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws
# Optional — name of the SpeechSynthesis voice to use for TTS playback.
# Leave blank to auto-pick (Samantha → Karen → first local en-US voice).
# Examples: "Samantha", "Karen", "Google US English".
# NEXT_PUBLIC_TTS_VOICE=
