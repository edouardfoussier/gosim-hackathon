# ─── Z.AI / GLM (primary LLM provider — proxied via api.r9s.ai for GOSIM) ─
# The GOSIM hackathon credentials route through https://api.r9s.ai/v1, an
# OpenAI-compatible proxy that exposes:
#   - glm-5.1   (latest GLM, default for Xiexie)
#   - glm-5
#   - deepseek-v4-pro
#   - deepseek-v4-flash
# The proxy does NOT currently expose vision (GLM-4V/5V) or audio
# (GLM-ASR-2512). Vision and audio paths in our code degrade gracefully
# when the corresponding model is unset.
#
# For direct Z.AI access (vision + audio + GLM-Image + CogVideoX), ask the
# Z.AI mentor on-site for a https://api.z.ai/api/paas/v4 key.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.r9s.ai/v1
ZAI_MODEL=glm-5.1
ZAI_VISION_MODEL=
ZAI_FALLBACK_MODEL=deepseek-v4-pro

# ─── OpenAI fallback (dev only — used until ZAI key is in hand) ───────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── ElevenLabs (optional — premium TTS for final demo video) ─────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Tavily (optional — live web scam intel for analyze_email) ────────────
# Without this key, search_scam_intel falls back to fixture data — fine for demo.
TAVILY_API_KEY=

# ─── External scam-intel APIs (all optional, all free-tier) ───────────────
# Keys missing → check_url uses mock fixtures + no-JS fetch only (demo-safe).
# Get keys at:
#   https://developers.google.com/safe-browsing  (free, non-commercial)
#   https://urlscan.io/user/signup/              (free read access without key,
#                                                 key lifts rate limit)
#   https://emailrep.io/                         (free tier, ~50 req/day
#                                                 unauthenticated)
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_API_KEY=
EMAILREP_API_KEY=

# ─── Backend ──────────────────────────────────────────────────────────────
BACKEND_PORT=8787
WIKI_DIR=./data/wiki
RAW_DIR=./data/raw

# ─── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws
