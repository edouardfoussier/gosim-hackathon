# Copy to ``worker/.dev.vars`` and fill the three secrets.
# ``.dev.vars`` is gitignored (Clicky's .gitignore + ours both cover it).
# Used by ``npx wrangler dev`` for local development.
#
# For production deploys, use ``npx wrangler secret put`` instead.

# ── Z.AI (LLM orchestrator + vision via GLM-4.6 / GLM-4.5V) ─────────
# Get yours at https://docs.z.ai/api-reference/introduction
# (the same key you used for the legacy backend; reuse it directly).
ZAI_API_KEY=

# Optional override — leave commented to use the wrangler.toml defaults
# (api.z.ai/api/paas/v4 + glm-4.6 + glm-4.5v).
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_TEXT_MODEL=glm-4.6
# ZAI_VISION_MODEL=glm-4.5v

# ── AssemblyAI (push-to-talk streaming STT) ─────────────────────────
# Free key at https://www.assemblyai.com/app/account/keys
ASSEMBLYAI_API_KEY=

# ── ElevenLabs (warm TTS playback) ──────────────────────────────────
# Free key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
