<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Custom Info.plist keys merged into the bundled Xiexie.app/Contents/Info.plist
    by the Tauri v2 bundler (referenced via bundle.macOS.infoPlist).

    macOS REQUIRES a usage-description string for every TCC-protected resource;
    without these the system silently denies access and the WKWebView reports
    `getUserMedia is not available in this browser` to JavaScript instead of
    surfacing the standard permission prompt to the user.
  -->

  <!-- Microphone — wake-word + STT pipeline + the OpenAI Realtime peer
       connection from the embedded Next.js webview. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Xiexie listens to your voice so it can read you your emails, warn you about scams, and help with everyday tasks. Audio stays on your Mac unless you turn on the cloud voice option.</string>

  <!-- AppleScript / System Events automation — open_app, set_reminder,
       archive_email, report_to_family, zoom_text. -->
  <key>NSAppleEventsUsageDescription</key>
  <string>Xiexie uses Apple Events to open apps, set reminders, draft emails, and adjust text size on your behalf — only after you ask it to.</string>

  <!-- Screen recording — required by the read_screen skill (GLM-4.5V vision). -->
  <key>NSScreenRecordingUsageDescription</key>
  <string>Xiexie can read what's on your screen out loud when you ask it to ("What does this say?"). The screenshot is sent only to the model you've configured and is never stored.</string>

  <!-- Camera — not used today but pre-declared in case a future skill
       wants visual interaction. Removing this makes a future build
       that needs camera silently fail just like the mic did. -->
  <key>NSCameraUsageDescription</key>
  <string>Xiexie does not use the camera today; the entry is reserved for a future video-call helper skill.</string>

  <!-- Menu-bar / accessory app: no Dock icon, no Cmd-Tab entry, lives
       in the status bar tray. The macOS equivalent of the
       skipTaskbar: true option in tauri.conf.json. -->
  <key>LSUIElement</key>
  <true/>

  <!-- Pre-load high-DPI app icon for the menu bar tray on Retina. -->
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
